@REM ----------------------------------------------------------------------------
@REM Maven Start Up Batch script
@REM ----------------------------------------------------------------------------

@echo off
@setlocal

set ERROR_CODE=0

@REM Check for JAVA_HOME or java.exe on PATH
if not "%JAVA_HOME%"=="" goto OkJHome
for %%i in (java.exe) do set "JAVACMD=%%~$PATH:i"
goto checkJCmd

:OkJHome
set "JAVACMD=%JAVA_HOME%\bin\java.exe"

:checkJCmd
if exist "%JAVACMD%" goto runWrapper

echo.
echo Error: JAVA_HOME is not defined and java.exe was not found in PATH. >&2
echo Please install JDK 21 and configure JAVA_HOME. >&2
echo.
exit /B 1

:runWrapper
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0.mvn\wrapper\mvnw.ps1" %*
set ERROR_CODE=%ERRORLEVEL%
exit /B %ERROR_CODE%
